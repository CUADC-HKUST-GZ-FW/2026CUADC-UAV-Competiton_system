# ============================================================
# UAV SITL 本机配置模板
#
# 使用：
#
# cp config/sitl_local.env.example config/sitl_local.env
#
# 然后只修改 config/sitl_local.env
# ============================================================

# ROS2 workspace
export UAV_ROS_WS="${HOME}/uav_ros2_ws"

# ArduPilot repo
export ARDUPILOT_DIR="${HOME}/ardupilot"

# sim_vehicle.py --add-param-file 使用的参数文件
export UAV_PARAM_FILE="${HOME}/uav_param_filter/filter_result_v3/params_to_import.param"

# MAVProxy wp load 使用的航点文件
export UAV_WAYPOINT_FILE="${UAV_ROS_WS}/wp/0826全流程.waypoints"

# SITL 起飞点
# 格式：
# latitude,longitude,altitude,heading
export UAV_CUSTOM_LOCATION="22.8817230,113.4882814,20,0.0"

# SITL --out 与 MAVROS 的连接端口必须配套
export UAV_MAVROS_FCU_URL="udp://127.0.0.1:14551@"

# 超时
export UAV_SITL_TIMEOUT=180
export UAV_MAVROS_TIMEOUT=90
export UAV_MISSION_READY_TIMEOUT=120

# MAVProxy 命令之间的延迟
export UAV_COMMAND_DELAY=2
