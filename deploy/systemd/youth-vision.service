[Unit]
Description=Youth Vision Competition Recon (image mode autostart)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=nx163
WorkingDirectory=/home/nx163/youth-vision-runtime
ExecStart=/home/nx163/youth-vision-runtime/scripts/competition_selected.sh image
ExecStop=/home/nx163/youth-vision-runtime/scripts/stop_recon_pipeline.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
