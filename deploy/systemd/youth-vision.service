[Unit]
Description=NX163 single-target image recognition and UAV fusion chain
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nx163
Environment=HOME=/home/nx163
Environment=UAV_FOREGROUND=1
WorkingDirectory=/home/nx163/uav_ros2_project
ExecStart=/home/nx163/uav_ros2_project/scripts/start_single_target_fusion.sh image 0.00
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=youth-vision

[Install]
WantedBy=multi-user.target
